#250
Prelude the Old Sexton greet~
if ispc $n
  mob echoat $n {cThe Old Sexton lifts his lantern and squints at you.{x
  mob echoat $n {w'Another lost one wandering out of the woods. Welcome, child.'{x
  mob echoat $n {w'This old cathedral will teach you how to survive in Haven.'{x
  mob echoat $n {w{rIMPORTANT:{w read the {csign{w in every room ({clook sign{w) and talk to every guide.{x
  mob echoat $n {w'Say {ctopics{w and I will list what I can teach you.'{x
endif
~
#251
Prelude the Old Sexton topics~
mob echoat $n {cThe Sexton counts on muddy fingers:{x
mob echoat $n {w'Say any of these words aloud and I will explain:'{x
mob echoat $n {w  {ccommands{w  - the handful of commands you need first{x
mob echoat $n {w  {cmovement{w  - how to walk the world{x
mob echoat $n {w  {cooc{w       - in-character vs out-of-character chat{x
mob echoat $n {w'When you are done, walk {cnorth{w into the narthex.'{x
~
#252
Prelude the Old Sexton commands~
mob echoat $n {cThe Sexton ticks them off one by one:{x
mob echoat $n {w  {clook{w        - see the room; {clook <thing>{w examines anything{x
mob echoat $n {w  {cscore{w       - your health, level and vital statistics{x
mob echoat $n {w  {cinventory{w / {cequipment{w - what you carry and wear{x
mob echoat $n {w  {cwho{w         - who else is awake in the world{x
mob echoat $n {w  {chelp <word>{w - the help files cover nearly everything{x
mob echoat $n {w  {ccommands{w    - the full list of every command{x
~
#253
Prelude the Old Sexton movement~
mob echoat $n {cThe Sexton points his spade down the path:{x
mob echoat $n {w'Walk with {cnorth south east west up down{w (or {cn s e w u d{w).'{x
mob echoat $n {w'Type {cexits{w to see which ways you can go.'{x
mob echoat $n {w'In this cathedral, the way forward is always {cnorth{w.'{x
~
#254
Prelude the Old Sexton ooc~
mob echoat $n {cThe Sexton lowers his voice:{x
mob echoat $n {w'Haven is a {yroleplaying{w game. Most of what you say is {yin-character{w.'{x
mob echoat $n {w  {csay <text>{w  - speak IN character to the room{x
mob echoat $n {w  {cosay <text>{w - speak OUT of character to the room{x
mob echoat $n {w  {cooc <text>{w  - the global OUT of character channel{x
mob echoat $n {w'Ask game questions on {cooc{w - players are glad to help.'{x
mob echoat $n {w'Keep modern chatter out of {csay{w.'{x
~
