log/*
!log/.gitkeep
memdump/
import/
data/*.not
data/ban.txt
data/bugs.txt
data/typos.txt
data/laston.txt
data/last.txt
data/player.lst
data/shutdown.txt
data/web_who.json
data/*.bak
data/*.pre-init
nohup.out
scripts/nohup.out

# External / production area files (keep core defaults tracked)
area/*.are
!area/limbo.are
!area/codespecii.are
