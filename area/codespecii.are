#250
Prelude Herald Greet~
if ispc $n
  mob echoat $n {CThe Herald of Awakening greets you warmly.{x
  mob echoat $n {W'Welcome, traveler, to the Threshold of Awakening.'{x
  mob echoat $n {W'I am here to guide your first steps. Type {Ylook post{W to view the room index,'{x
  mob echoat $n {W'or speak aloud: {Ysay commands{W or {Ysay movement{W to learn the basics.'{x
  mob echoat $n {W'When you are ready, proceed {Ynorth{W into the Hall of Forms.'{x
endif
~
#251
Prelude Herald Commands Speech~
mob echoat $n {CThe Herald of Awakening smiles and speaks:{x
mob echoat $n {W'Essential Haven commands to remember:'{x
mob echoat $n {W'  {Ylook{W     - Examine your surroundings, objects, or players.'{x
mob echoat $n {W'  {Yscore{W    - View your current health, blood, and vital status.'{x
mob echoat $n {W'  {Yworth{W    - Check your accumulated silver and gold coins.'{x
mob echoat $n {W'  {Yhelp{W     - Search the extensive help archive on any topic.'{x
mob echoat $n {W'  {Ysay <msg>{W- Converse in-character with those in your room.'{x
~
