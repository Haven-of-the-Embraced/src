#250
Prelude the Old Sexton greet~
if ispc $n
  mob echoat $n {cthe Old Sexton says,{w 'Another lost one wandering out of the woods. Welcome, child.'{x
  mob echoat $n {cthe Old Sexton says,{w 'This old cathedral will teach you how to survive in Haven.'{x
  mob echoat $n {cthe Old Sexton says,{w 'Read the {Csign{w in every room ({Clook sign{w) and talk to each guide.'{x
  mob echoat $n {cthe Old Sexton says,{w 'Say '{Csay topics{w' and I will list what I can teach you.'{x
endif
~
#251
Prelude the Old Sexton topics~
mob echoat $n {cthe Old Sexton says,{w 'Say any of these words aloud and I will explain:'{x
mob echoat $n {w  {Ccommands{w  - the handful of commands you need first{x
mob echoat $n {w  {Cmovement{w  - how to walk the world{x
mob echoat $n {w  {Cooc{w       - in-character vs out-of-character chat{x
mob echoat $n {cthe Old Sexton says,{w 'When you are done, walk {cnorth{w into the narthex.'{x
~
#252
Prelude the Old Sexton commands~
mob echoat $n {cthe Old Sexton says,{w 'Essential commands for your journey:'{x
mob echoat $n {w  {Clook{w        - view the room; {Clook <thing>{w examines anything{x
mob echoat $n {w  {Cscore{w       - your health, blood, level, and vital statistics{x
mob echoat $n {w  {Cinventory{w   - inspect items you are carrying{x
mob echoat $n {w  {Cequipment{w   - inspect equipment you are wearing{x
mob echoat $n {w  {Cwho{w         - see who else is awake in the world{x
mob echoat $n {w  {Chelp <word>{w - search help archives for any system or rule{x
mob echoat $n {w  {Ccommands{w    - display a list of all available commands{x
~
