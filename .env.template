# ==============================================================================
# Haven of the Embraced - Environment Configuration Template
# Copy this file to .env (`cp .env.template .env`) and fill in your credentials.
# Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Resend Email API Configuration (Used by scripts/send_email.py)
# How to obtain RESEND_API_KEY:
#   1. Sign in or create an account at https://resend.com/login
#   2. Verify your sending domain at https://resend.com/domains
#   3. Navigate to https://resend.com/api-keys
#   4. Click "Create API Key", name it (e.g., "HavenMUD Server"), select
#      "Sending access", and copy the generated key (starts with `re_`).
# ------------------------------------------------------------------------------
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="admin@havenmud.net"

# ------------------------------------------------------------------------------
# 2. Discord Bot Configuration (Optional - Used by scripts/discord_bot/bot.py)
# How to obtain DISCORD_TOKEN:
#   1. Go to the Discord Developer Portal: https://discord.com/developers/applications
#   2. Click "New Application" (or select your existing Haven bot application).
#   3. In the left sidebar, select "Bot", enable "Message Content Intent" under
#      Privileged Gateway Intents, and click "Reset Token" / "Copy" to get the token.
# ------------------------------------------------------------------------------
DISCORD_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Local Docker Overrides (Optional - Used by compose.yaml)
# ------------------------------------------------------------------------------
HAVEN_PORT=4000
HAVEN_AREA_DIR=./area
HAVEN_DATA_DIR=./data
HAVEN_PLAYER_DIR=./player
