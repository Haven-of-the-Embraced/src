mob echoat $n {W'as well as {Yup{W and {Ydown{W (abbreviated {Yn, s, e, w, u, d{W).'{x
mob echoat $n {W'Type {Yexits{W at any time to see obvious exits leading from your location.'{x
mob echoat $n {W'Head {Ynorth{W now to inspect your Character Sheet.'{x
~
