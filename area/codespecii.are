#276
Prelude the Scriptorium Monk skillmap~
mob echoat $n {cthe Scriptorium Monk says,{w 'The Skill Matrix System:'{x
mob echoat $n {w  {Cskillmap{w        - list all skills and their attribute/ability requirements{x
mob echoat $n {w  {Cskillmap <trait>{w- list skills governed by a specific trait (e.g. dexterity){x
mob echoat $n {w  {Cskills{w          - list skills currently unlocked for your character{x
mob echoat $n {cthe Scriptorium Monk says,{w 'When your dots meet the threshold, skills unlock automatically.'{x
~
#277
Prelude the Scriptorium Monk learning~
mob echoat $n {cthe Scriptorium Monk says,{w 'Advancement through active use:'{x
mob echoat $n {w  - Skills advance dynamically by using them in combat, stealth, or crafting{x
mob echoat $n {w  - Each successful use rolls an improvement check based on relevant stats{x
mob echoat $n {w  - Practice sessions and trainer gold do NOT exist on this engine{x
~
#278
Prelude the Scriptorium Monk weapon_skills~
mob echoat $n {cthe Scriptorium Monk says,{w 'Secondary weapon skills on {Ccs3{w govern your mastery caps:'{x
mob echoat $n {w  {cProficiencies:{w Light, Heavy, Blunt, Polearm{x
mob echoat $n {w  {cImpact:{w        Higher secondary dots allow your combat weapon skill to reach 100%{x
mob echoat $n {w  {cSyntax:{w        Read '{Chelp weapon_skills{w' and buy dots via '{Cfreebie <skill>{w'{x
~
#279
Prelude the Keeper of Bones greet~
if ispc $n
  mob echoat $n {cthe Keeper of Bones says,{w 'Death is merely a threshold in Haven.'{x
  mob echoat $n {cthe Keeper of Bones says,{w '{WRemort{w is the sole engine through which all souls grow powerful.'{x
  mob echoat $n {cthe Keeper of Bones says,{w 'Say '{Csay topics{w' to understand the great cycle.'{x
endif
~
#280
Prelude the Keeper of Bones topics~
mob echoat $n {cthe Keeper of Bones says,{w 'Speak of the great transitions:'{x
mob echoat $n {w  {Cremort{w - level 100 reset, freebie rewards, and character persistence{x
mob echoat $n {w  {Cpaths{w  - supernatural paths: Garou, Mage, and Kindred Embrace{x
~
#281
Prelude the Keeper of Bones remort~
mob echoat $n {cthe Keeper of Bones says,{w 'The Remort Progression Engine:'{x
mob echoat $n {w  {cRequirement:{w Reach level {W100{w and type '{Cremort{w'{x
mob echoat $n {w  {cReset:{w       Level resets to {W1{w to begin leveling anew{x
mob echoat $n {w  {cKept:{w        ALL equipment, ALL learned skills, ALL Character Sheet dots{x
mob echoat $n {w  {cReward:{w      {C+3 Freebies{w per remort, unlocking higher supernatural caps{x
mob echoat $n {cthe Keeper of Bones says,{w 'Remorting is NOT optional—it is the true path of character progression.'{x
~
#282
Prelude the Keeper of Bones paths~
mob echoat $n {cthe Keeper of Bones says,{w 'Major Supernatural Transitions:'{x
mob echoat $n {w  {cGarou (Werewolf):{w Mortal reaches level 100 -> '{Cremort garou{w' -> '{Cgogarou{w'{x
mob echoat $n {w  {cMage (Awakened):{w  Mortal reaches level 100 -> '{Cremort mage <tradition>{w'{x
mob echoat $n {w  {cKindred (Vampire):{w Granted through in-character Embrace by another vampire player{x
mob echoat $n {cthe Keeper of Bones says,{w 'Type '{Chelp remort{w' for detailed rules before choosing a path.'{x
~
#283
Prelude the Bishop of the Belfry greet~
if ispc $n
  mob echoat $n {cthe Bishop of the Belfry says,{w 'You have traversed the entire cathedral. Well done.'{x
  mob echoat $n {cthe Bishop of the Belfry says,{w 'Say '{Csay graduate{w' when ready to ring the bell and enter the world.'{x
  mob echoat $n {cthe Bishop of the Belfry says,{w 'Or say '{Csay topics{w' for a final orientation recap.'{x
endif
~
#284
Prelude the Bishop of the Belfry topics~
mob echoat $n {cthe Bishop of the Belfry says,{w 'Final preparations before departing:'{x
mob echoat $n {w  {Csummary{w  - concise recap of all core systems{x
mob echoat $n {w  {Cvampire{w  - survival fundamentals for Kindred characters{x
mob echoat $n {w  {Cmortal{w   - survival fundamentals for mortal characters{x
mob echoat $n {w  {Cgraduate{w - toll the bell and transport to The New Temple{x
~
#285
Prelude the Bishop of the Belfry summary~
mob echoat $n {cthe Bishop of the Belfry says,{w 'Core Haven mechanics summary:'{x
mob echoat $n {w  {cCharacter Sheet:{w {Ccs{w, {Ccs2{w, {Ccs3{w, {Cbackgrounds{w{x
mob echoat $n {w  {cBuilder:{w         {Ccreate{w (must complete if you chose custom){x
mob echoat $n {w  {cWeapon Skills:{w   {Chelp weapon_skills{w (invest 2-3 freebies in a proficiency){x
mob echoat $n {w  {cFreebies:{w        {Cfreebie{w (costs scale with current rating){x
mob echoat $n {w  {cSkill Map:{w       {Cskillmap{w (dots unlock skills; use improves them){x
mob echoat $n {w  {cRemort:{w          {Cremort{w at level 100 (+3 freebies per remort){x
mob echoat $n {w  {cCommunication:{w   {Csay{w (IC), {Cosay{w (OOC room), {Cooc{w (OOC global){x
~
#286
Prelude the Bishop of the Belfry vampire~
mob echoat $n {cthe Bishop of the Belfry says,{w 'Essential Kindred survival commands:'{x
mob echoat $n {w  {Cfangs{w      - extend fangs before feeding{x
mob echoat $n {w  {Cfeed{w       - slake hunger during combat to replenish Blood Pool{x
mob echoat $n {w  {Cregenerate{w - heal wounds using vitae{x
mob echoat $n {w  {Cdisclist{w   - view available vampiric disciplines{x
mob echoat $n {w  {Cbloodbuff{w  - surge physical attributes with blood{x
mob echoat $n {cthe Bishop of the Belfry says,{w '{RWarning:{w Beware sunlight and fire. Maintain your humanity to restrain the Beast.'{x
~
#287
Prelude the Bishop of the Belfry mortal~
mob echoat $n {cthe Bishop of the Belfry says,{w 'Essential mortal survival guidance:'{x
mob echoat $n {w  - Equip armor, weapons, and bandages before venturing beyond city gates{x
mob echoat $n {w  - Level up to 100 to undergo Remort into Mage or Garou{x
mob echoat $n {w  - Or seek an elder vampire player to negotiate the Embrace into Kindred status{x
~
#288
Prelude the Bishop of the Belfry graduate~
mob echoat $n {cThe Bishop of the Belfry hauls on the great bell rope.{x
mob echoat $n {cBOOOONG... The great bronze bell tolls solemnly.{x
mob echoat $n {WThe stone walls of the old cathedral dissolve into light as you step forth!{x
mob transfer $n 101
~
